# ─── MatClaw Configuration ────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Choose ONE provider. The model must match the provider.

# Option A — NVIDIA (default, best for MATLAB-heavy tasks)
MATCLAW_LLM__PROVIDER=nvidia
MATCLAW_LLM__MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
NVIDIA_API_KEY=nvapi-...

# Option B — Anthropic Claude
# MATCLAW_LLM__PROVIDER=anthropic
# MATCLAW_LLM__MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# Option C — OpenAI
# MATCLAW_LLM__PROVIDER=openai-compatible
# MATCLAW_LLM__MODEL=gpt-4o
# MATCLAW_LLM__BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Option D — Google Gemini
# MATCLAW_LLM__PROVIDER=google
# MATCLAW_LLM__MODEL=gemini-1.5-pro
# GOOGLE_API_KEY=AIza...

# ─── MATLAB Bridge ────────────────────────────────────────────────────────────
# Set to true only if MATLAB is installed on the host (native install only).
# Docker users: leave false unless you've installed the MATLAB engine wheel.
MATCLAW_MATLAB__ENABLED=false

# ─── Server ───────────────────────────────────────────────────────────────────
MATCLAW_HOST=0.0.0.0
MATCLAW_PORT=8000

# Open browser automatically on startup (native install only)
MATCLAW_OPEN_BROWSER=true

# ─── GB10 / DGX Spark Cluster ("constellation") ──────────────────────────────
# Two-node cluster connected via direct link.
# Node 1: gn100-93da  — mgmt 10.100.120.1, interconnect 10.100.121.1
# Node 2: spark-3d03.local — mgmt 10.100.120.2, interconnect 10.100.121.2
MATCLAW_GB10__ENABLED=false
MATCLAW_GB10__CLUSTER_NAME=constellation
# Nodes are configured as a JSON array (env var with nested delimiter):
# MATCLAW_GB10__NODES='[{"ssh_alias":"gn100-93da","ssh_user":"ubuntu","interconnect_ip":"10.100.121.1","management_ip":"10.100.120.1"},{"ssh_alias":"spark-3d03.local","ssh_user":"ubuntu","interconnect_ip":"10.100.121.2","management_ip":"10.100.120.2"}]'
# MATCLAW_GB10__SSH_KEY_PATH=~/.ssh/id_ed25519
# MATCLAW_GB10__REMOTE_WORK_DIR=/tmp/matclaw_jobs
# MATCLAW_GB10__CUDA_HOME=/usr/local/cuda
# MATCLAW_GB10__GPU_CODER_ENABLED=false
# MATCLAW_GB10__MULTI_NODE_STRATEGY=split
# MATCLAW_GB10__TIMEOUT_SECONDS=600

# ─── Optional: Telegram Notifications ────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
